<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Chef.Master.cs" Inherits="CookingLah.Pages.Chef.Chef" %>
<!DOCTYPE html>
<html lang="en">
    <head runat="server">
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title></title>
        <link
            runat="server"
            rel="icon"
            type="image/x-icon"
            href="~/favicon.ico?v=2" />
        <link runat="server" href="~/F_CSS/Style.css" rel="stylesheet" />
        <link runat="server" href="~/F_CSS/Master.css" rel="stylesheet" />
        <asp:ContentPlaceHolder ID="ChefHead" runat="server" />
        <asp:ContentPlaceHolder ID="ProfileHead" runat="server" />
    </head>
    <body class="master-shell">
        <form id="chefForm" runat="server">
            <a class="master-skip" href="#masterMain">Skip to content</a>
            <header class="master-header" id="masterHeader">
                <button
                    type="button"
                    class="sidebar-toggle"
                    id="sidebarToggle"
                    aria-controls="masterSidebar"
                    aria-expanded="false"
                    aria-label="Expand navigation"
                    title="Expand navigation">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect
                            x="3"
                            y="4"
                            width="18"
                            height="16"
                            rx="3" /><path d="M9 4v16" /><path class="sidebar-toggle-arrow" d="m15 9-3 3 3 3" /></svg>
                </button>
                <a runat="server" href="~/Pages/Chef/ChefDashboard.aspx" class="site-logo"><img runat="server" src="~/F_Assets/CookingLahLogo.png" alt="Cooking LAH dashboard" /></a>
                <div class="master-header-caption">Your teaching notebook<span>Share your skills. Inspire a cook.</span></div>
                <div class="master-profile">
                    <a href='<%= ResolveUrl("~/Pages/Shared/Profile/ProfilePage.aspx") %>' class="master-profile-link">
                        <asp:Image
                            ID="imgLearnerProfile"
                            runat="server"
                            ImageUrl="~/F_Assets/mascot.png"
                            AlternateText="Chef profile photo" />
                        <div class="master-profile-copy"><asp:Label ID="lblProfileName" runat="server" /><small>Chef</small></div>
                    </a>
                    <asp:Button
                        ID="btnHeaderLogout"
                        runat="server"
                        Text="Log out"
                        CssClass="btn master-logout"
                        CausesValidation="false"
                        OnClick="Logout_Click" />
                </div>
            </header>
            <div class="master-layout">
                <aside class="master-sidebar" id="masterSidebar" aria-label="Chef navigation">
                    <button type="button" class="btn sidebar-close" id="sidebarClose">Close menu</button>
                    <p class="master-sidebar-heading">My teaching kitchen</p>
                    <nav class="master-nav" aria-label="Chef">
                        <a
                            runat="server"
                            href="~/Pages/Chef/ChefDashboard.aspx"
                            class="master-nav-item"
                            data-page="ChefDashboard"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m3 10 9-7 9 7v10H3ZM9 20v-7h6v7" /></svg><span>Dashboard</span></a>
                <%-- Placeholder destinations are intentionally disabled until those pages exist. --%>
                        <p class="master-nav-label">COURSE MANAGEMENT</p>
                        <a
                            runat="server"
                            href="~/Pages/Chef/MyCourse/ChefMyCourse.aspx"
                            class="master-nav-item"
                            data-page="ChefMyCourse,ManageCoursePage"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 5v16M12 5C8 2 4 3 2 4v15c4-1 7-1 10 2 3-3 6-3 10-2V4c-2-1-6-2-10 1Z" /></svg><span>My Courses</span></a>
                        <a
                            runat="server"
                            href="~/Pages/Chef/CreateCourse/CreateCoursePage.aspx"
                            class="master-nav-item"
                            data-page="CreateCoursePage"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14" /></svg><span>Create Course</span></a>
                        <a
                            runat="server"
                            href="~/Pages/Chef/CourseReport/CourseReportPage.aspx"
                            class="master-nav-item"
                            data-page="CourseReportPage"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 3v18h17M8 16v-4m5 4V8m5 8V4" /></svg><span>Course Report</span></a>
                        <p class="master-nav-label">LEARNERS</p>
                        <a
                            runat="server"
                            href="~/Pages/Chef/ChefReviewSubmission/ChefReviewSubmissionPage.aspx"
                            class="master-nav-item"
                            data-page="ChefReviewSubmissionPage"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 6h4l2-3h6l2 3h4v15H3Z" /><circle cx="12" cy="13" r="4" /></svg><span>Activity Submissions</span></a>
                        <a
                            runat="server"
                            href="~/Pages/Chef/ChefViewReview/ChefViewReviewPage.aspx"
                            class="master-nav-item"
                            data-page="ChefViewReviewPage"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m12 3 3 6 7 1-5 5 1 7-6-3-6 3 1-7-5-5 7-1Z" /></svg><span>Course Reviews</span></a>
                        <p class="master-nav-label">Live Session</p>
                        <a
                            runat="server"
                            href="~/Pages/LiveSessionPage/ChefStartLive.aspx"
                            class="master-nav-item"
                            data-page="ChefStartLive,ChefLivePage"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m12 3 3 6 7 1-5 5 1 7-6-3-6 3 1-7-5-5 7-1Z" /></svg><span>My Live</span></a>
                        <p class="master-nav-label">Account</p>
                        <a class="master-nav-item" data-page="ProfilePage" href='<%= ResolveUrl("~/Pages/Shared/Profile/ProfilePage.aspx") %>'><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="7" r="4" /><path d="M4 21v-2a8 8 0 0 1 16 0v2" /></svg><span>Profile</span></a>
                        <asp:LinkButton
                            ID="btnSidebarLogout"
                            runat="server"
                            CssClass="master-nav-item"
                            OnClick="Logout_Click"
                            CausesValidation="false"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M10 3H3v18h7M9 12h12m-5-5 5 5-5 5" /></svg><span>Log out</span></asp:LinkButton>
                    </nav>
                    <div class="master-nav-note"><span>Good things take thyme.</span><p>More kitchen tools are on the way. Muted links are coming soon.</p>
                    </div>
                </aside>
                <button
                    type="button"
                    id="sidebarOverlay"
                    class="master-overlay"
                    aria-label="Close navigation"
                    tabindex="-1"
                    hidden></button>
                <main class="master-main" id="masterMain" tabindex="-1">
                    <asp:ContentPlaceHolder ID="ChefContent" runat="server" />
                    <asp:ContentPlaceHolder ID="ProfileContent" runat="server" />
                </main>
            </div>
            <script src="<%= ResolveUrl("~/F_JavaScripts/connectionChecker.js") %>" defer></script>
            <script src="<%= ResolveUrl("~/F_JavaScripts/Master.js") %>" defer></script>
            <asp:ContentPlaceHolder ID="ChefScripts" runat="server" />
            <asp:ContentPlaceHolder ID="ProfileScripts" runat="server" />
            <asp:ContentPlaceHolder ID="LiveScripts" runat="server" />
        </form>
    </body>
</html>
