<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Admin.Master.cs" Inherits="CookingLah.Pages.Admin.Admin" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title></title>
    <link runat="server" href="~/F_CSS/Style.css" rel="stylesheet" />
    <link runat="server" href="~/F_CSS/Master.css" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="AdminHead" runat="server" />
    <asp:ContentPlaceHolder ID="ProfileHead" runat="server" />
</head>
<body class="master-shell">
<form id="adminForm" runat="server">
    <a class="master-skip" href="#masterMain">Skip to content</a>
    <header class="master-header" id="masterHeader">
        <button type="button" class="sidebar-toggle" id="sidebarToggle" aria-controls="masterSidebar" aria-expanded="false" aria-label="Expand navigation" title="Expand navigation">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="4" width="18" height="16" rx="3" /><path d="M9 4v16" /><path class="sidebar-toggle-arrow" d="m15 9-3 3 3 3" /></svg>
        </button>
        <a runat="server" href="~/Pages/Admin/AdminDashboard.aspx" class="site-logo"><img runat="server" src="~/F_Assets/CookingLahLogo.png" alt="Cooking LAH dashboard" /></a>
        <div class="master-header-caption">Your admin notebook<span>Keep the Cooking LAH community growing.</span></div>
        <div class="master-profile">
            <a href='<%= ResolveUrl("~/Pages/Shared/Profile/ProfilePage.aspx") %>' class="master-profile-link">
                <asp:Image ID="imgLearnerProfile" runat="server" ImageUrl="~/F_Assets/mascot.png" AlternateText="Admin profile photo" />
                <div class="master-profile-copy"><asp:Label ID="lblProfileName" runat="server" /><small>Admin</small></div>
            </a>
            <asp:Button ID="btnHeaderLogout" runat="server" Text="Log out" CssClass="btn master-logout" CausesValidation="false" OnClick="Logout_Click"/>
        </div>
    </header>
    <div class="master-layout">
        <aside class="master-sidebar" id="masterSidebar" aria-label="Admin navigation">
            <button type="button" class="btn sidebar-close" id="sidebarClose">Close menu</button>
            <p class="master-sidebar-heading">Administration</p>
            <nav class="master-nav" aria-label="Admin">
                <a runat="server" href="~/Pages/Admin/AdminDashboard.aspx" class="master-nav-item" data-page="AdminDashboard"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m3 10 9-7 9 7v10H3ZM9 20v-7h6v7" /></svg><span>Dashboard</span></a>
                <%-- Placeholder destinations are intentionally disabled until those pages exist. --%>
                <p class="master-nav-label">Management</p>
                <a runat="server" href="~/Pages/Admin/CourseContentReview/ReviewCoursesPage.aspx" class="master-nav-item" data-page="ReviewCoursesPage"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 4H4v17h16V4h-4M8 2h8v5H8ZM8 13l3 3 5-5" /></svg><span>Manage Course</span></a>
                <a runat="server" href="~/Pages/Admin/ManageCategories/ManagerCategoriesPage.aspx" class="master-nav-item" data-page="ManagerCategoriesPage"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" /></svg><span>Manage categories</span></a>
                <a runat="server" href="~/Pages/Admin/ManageUser/ManageUserPage.aspx" class="master-nav-item" data-page="ManageUserPage"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="10" cy="10" r="6" /><path d="m15 15 6 6" /></svg><span>Manage users</span></a>
                <p class="master-nav-label">Report Analysis</p>
                <a runat="server" href="~/Pages/Admin/UserReport/UserReportPage.aspx" class="master-nav-item" data-page="UserReportPage"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 3v18h17M8 16v-4m5 4V8m5 8V4" /></svg><span>User report</span></a>
                <p class="master-nav-label">Account</p>
                <a class="master-nav-item" data-page="ProfilePage" href='<%= ResolveUrl("~/Pages/Shared/Profile/ProfilePage.aspx") %>'><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="7" r="4" /><path d="M4 21v-2a8 8 0 0 1 16 0v2" /></svg><span>Profile</span></a>
                <asp:LinkButton ID="btnSidebarLogout" runat="server" CssClass="master-nav-item" OnClick="Logout_Click" CausesValidation="false"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M10 3H3v18h7M9 12h12m-5-5 5 5-5 5" /></svg><span>Log out</span></asp:LinkButton>
            </nav>
            <div class="master-nav-note"><span>Good things take thyme.</span><p>More kitchen tools are on the way. Muted links are coming soon.</p></div>
        </aside>
        <button type="button" id="sidebarOverlay" class="master-overlay" aria-label="Close navigation" tabindex="-1" hidden></button>
        <main class="master-main" id="masterMain" tabindex="-1">
            <asp:ContentPlaceHolder ID="AdminContent" runat="server" />
            <asp:ContentPlaceHolder ID="ProfileContent" runat="server" />
        </main>
    </div>
    <script src="<%= ResolveUrl("~/F_JavaScripts/Master.js") %>" defer></script>
    <asp:ContentPlaceHolder ID="AdminScripts" runat="server" />
    <asp:ContentPlaceHolder ID="ProfileScripts" runat="server" />
</form>
</body>
</html>

